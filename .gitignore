# ESP-IDF generated output
build/
managed_components/

# Local ESP-IDF configuration and generated files
sdkconfig
sdkconfig.old
sdkconfig.*.old

# Runtime/user data in LittleFS
data/config/wifi.json
data/config/wifi.tmp
data/config/yandex.json
data/config/*.tmp

# Python, editor and OS files
__pycache__/
*.py[cod]
.vscode/.ropeproject/
.vscode/.history/
# The ESP-IDF extension writes an absolute path to the local install into this
.vscode/settings.json
.DS_Store

# Internal session notes and agent planning
SESSION_CONTEXT.md
.superpowers/
docs/
.worktrees/
# Agent skills installed by `npx skills add`: .agents/ holds them, .claude/ is
# symlinks into it, and the lock file names the upstream repository. All three
# are this machine's tooling, not the firmware.
.agents/
.claude/
skills-lock.json
*.md
!README.md
!README.en.md

# Local photos and scratch images of the device
img/

# External audit reports and idea drafts
audit/
