CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Pool reserved for allocations that must be internal (DMA descriptors, task
# stacks). The hardware AES driver takes MALLOC_CAP_DMA memory for every TLS
# record, and PSRAM never carries that flag; with the I2S DMA buffers holding
# ~16 KB during playback, this pool is what HTTPS streaming competes for.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# Plain malloc() below this size prefers internal RAM. The ESP-IDF default of
# 16384 sends almost every allocation in this firmware there, crowding out the
# DMA-capable memory the AES driver needs; 1024 keeps only small, latency
# sensitive allocations internal and pushes the rest to PSRAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_FREERTOS_HZ=1000
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LWIP_TCP_WND_DEFAULT=16384
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
CONFIG_HTTPD_WS_SUPPORT=y
# Keep the whole network path on core 0, where the Wi-Fi task is already
# pinned. The lwIP task runs at priority 18 - above everything this project
# creates - so leaving it unpinned let it preempt the audio decoder on core 1
# mid-stream.
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
# Must cover the httpd session pool (WEB_SOCKET_SERVER_SOCKET_CAPACITY, see
# web_socket.h) plus the internet radio's streaming HTTP client socket and a
# few spares for DNS/mDNS lookups.
CONFIG_LWIP_MAX_SOCKETS=16
# Nothing here speaks IPv6: no source file references it, autoconfig was off,
# and the router hands out IPv4. Measured cost of leaving it on: 33 KB of
# flash and 1.8 KB of internal SRAM, the latter being the scarce one - TLS
# needs DMA-capable internal memory, which is what made HTTPS streams fail
# before. Note this also fixes TCP_MSS at 1440: that value is the IPv6 ceiling
# (1500 - 40 - 20), and only an IPv4-only build may raise it to 1460.
# CONFIG_LWIP_IPV6 is not set
# The USB flash drive is the only FAT volume. Without long-file-name support
# readdir() returns 8.3 aliases, which makes a music browser useless: a track
# named in Russian comes back as "______~1.MP3", identical for every such file.
# UTF-8 API encoding hands those names straight to LVGL and the web UI, and
# code page 866 keeps the DOS short-name aliases Cyrillic rather than 437.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_CODEPAGE_866=y
